{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "definitions": {
        "link": {
            "type": "object",
            "properties": {
                "display": {
                    "type": "string",
                    "description": "The text to display for the link."
                },
                "destination": {
                    "type": "string",
                    "description": "The URL or email address the link points to."
                }
            },
            "required": [
                "display"
            ],
            "additionalProperties": false
        },
        "date": {
            "type": "object",
            "properties": {
                "year": {
                    "type": "integer",
                    "description": "The year."
                },
                "month": {
                    "type": "integer",
                    "description": "The month.",
                    "minimum": 1,
                    "maximum": 12
                }
            },
            "required": [
                "year",
                "month"
            ],
            "additionalProperties": false
        },
        "subsection": {
            "type": "object",
            "properties": {
                "title": {
                    "type": "string",
                    "description": "The title of the subsection."
                },
                "subtitle": {
                    "type": "string",
                    "description": "The subtitle of the subsection."
                },
                "location": {
                    "type": "string",
                    "description": "The location associated with the subsection."
                },
                "from": {
                    "$ref": "#/definitions/date",
                    "description": "The start date of the subsection."
                },
                "to": {
                    "$ref": "#/definitions/date",
                    "description": "The end date of the subsection."
                },
                "text": {
                    "type": "string",
                    "description": "Typst markup text content of the subsection."
                },
                "items": {
                    "oneOf": [
                        {
                            "type": "array",
                            "description": "A list of items in the subsection.",
                            "items": {
                                "type": "string"
                            }
                        },
                        {
                            "type": "object",
                            "description": "A map of items in the subsection.",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    ]
                },
                "dates": {
                    "type": "string",
                    "description": "Freeform date text shown on the right; used instead of from/to."
                },
                "link": {
                    "type": "string",
                    "description": "URL the location text links to."
                }
            },
            "additionalProperties": false
        },
        "section": {
            "type": "object",
            "properties": {
                "title": {
                    "type": "string",
                    "description": "The title of the section."
                },
                "subsections": {
                    "type": "array",
                    "description": "A list of subsections within the section.",
                    "items": {
                        "$ref": "#/definitions/subsection"
                    }
                },
                "inline": {
                    "type": "boolean",
                    "description": "Render subsections on a compact inline layout (title | subtitle, with location/link on the right).",
                    "default": false
                }
            },
            "additionalProperties": false
        },
        "style": {
            "type": "object",
            "properties": {
                "font": {
                    "type": "string",
                    "description": "The font used in the resume."
                },
                "link-color": {
                    "type": "string",
                    "description": "The color of the links.",
                    "pattern": "^#[0-9a-fA-F]{3,8}$"
                },
                "header-color": {
                    "type": "string",
                    "description": "The color of the headers.",
                    "pattern": "^#[0-9a-fA-F]{3,8}$"
                },
                "divider-color": {
                    "type": "string",
                    "description": "The color of the dividers.",
                    "pattern": "^#[0-9a-fA-F]{3,8}$"
                },
                "font-size": {
                    "type": "string",
                    "description": "The base font size, e.g. 8.5pt."
                },
                "margin": {
                    "type": "string",
                    "description": "The page margin, e.g. 0.45in."
                }
            },
            "additionalProperties": false
        }
    },
    "properties": {
        "candidate-name": {
            "type": "string",
            "description": "The name of the candidate."
        },
        "job-title": {
            "type": "string",
            "description": "The job title of the candidate."
        },
        "links": {
            "type": "array",
            "description": "A list of links related to the candidate.",
            "items": {
                "$ref": "#/definitions/link"
            }
        },
        "sections": {
            "type": "array",
            "description": "A list of sections in the resume.",
            "items": {
                "$ref": "#/definitions/section"
            }
        },
        "style": {
            "$ref": "#/definitions/style",
            "description": "Styling options for the resume."
        }
    },
    "required": [
        "candidate-name",
        "job-title",
        "links",
        "sections",
        "style"
    ],
    "additionalProperties": false
}
